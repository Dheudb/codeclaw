{
  "name": "codeclaw-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeClaw desktop workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/workbench.e2e.cjs",
    "test:sessions": "node tests/sessions.e2e.cjs",
    "test:workspace": "node tests/workspace.e2e.cjs",
    "test:mcp": "node tests/mcp.e2e.cjs",
    "pack": "npm run build && node scripts/pack.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
