{
  "name": "codeclaw-desktop",
  "version": "0.1.0-beta.9",
  "private": true,
  "type": "module",
  "description": "CodeClaw desktop workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/workbench.e2e.cjs",
    "test:sessions": "node tests/sessions.e2e.cjs",
    "test:session-ownership": "node tests/session-ownership.e2e.cjs",
    "test:draft-exit": "node tests/draft-exit.e2e.cjs",
    "test:preferences": "node tests/preferences.e2e.cjs",
    "test:shutdown": "node tests/shutdown.e2e.cjs",
    "test:goals": "node tests/goals.e2e.cjs",
    "test:workspace": "node tests/workspace.e2e.cjs",
    "test:storage": "node tests/storage.e2e.cjs",
    "test:archives": "node tests/archives.e2e.cjs",
    "test:models": "node tests/models.e2e.cjs",
    "test:permissions": "node tests/permissions.e2e.cjs",
    "test:subagents": "node tests/subagents.e2e.cjs",
    "test:framework": "node tests/framework.e2e.cjs",
    "test:tool-recovery": "node tests/tool-recovery.e2e.cjs",
    "test:streaming": "node tests/streaming.e2e.cjs",
    "test:subagent-completion": "node tests/subagent-completion.e2e.cjs",
    "test:appearance": "node tests/appearance.e2e.cjs",
    "test:resume": "node tests/resume.e2e.cjs",
    "test:attachments": "node tests/attachments.e2e.cjs",
    "test:activity": "node tests/activity.e2e.cjs",
    "test:scroll-layout": "node tests/scroll-layout.e2e.cjs",
    "test:turns": "node tests/turns.e2e.cjs",
    "test:links": "node tests/links.e2e.cjs",
    "test:skills": "node tests/skills.e2e.cjs",
    "test:moves": "node tests/moves.e2e.cjs",
    "test:files": "node tests/files.e2e.cjs",
    "test:html": "node tests/html.e2e.cjs",
    "test:mcp": "node tests/mcp.e2e.cjs",
    "pack": "npm run build && node scripts/pack.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
